# --- Required ---

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather

# Anthropic API key for Claude (fact generation)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Brave Search API key for fact verification (https://brave.com/search/api/)
BRAVE_API_KEY=your_brave_api_key

# --- Deployment (optional) ---

# Public URL enables webhook mode; leave unset for local polling
# WEBHOOK_URL=https://your-app.railway.app
# PORT=8000

# --- Database (optional; SQLite is used when neither is set) ---

# PostgreSQL connection string
# DATABASE_URL=postgresql://user:pass@host:port/db
# Use Firestore backend instead ("true" to enable)
# USE_FIRESTORE_DB=true
# Custom SQLite volume path (auto-detected as /data on Railway)
# VOLUME_PATH=/data

# --- Optional integrations ---

# Yandex search fallbacks (images + web search when Brave is rate-limited)
# YANDEX_API_KEY=your_yandex_api_key
# YANDEX_FOLDER_ID=your_yandex_folder_id
# YANDEX_SEARCH_REGION=225

# Cached Telegram file IDs for the /live onboarding images
# HOWTO_STEP1_FILE_ID=
# HOWTO_STEP2_FILE_ID=
# HOWTO_STEP3_FILE_ID=

# --- AI tuning (optional) ---

# Thinking token budgets apply to Haiku 4.5 only
# (Claude 5 models use adaptive thinking with effort instead)
# CLAUDE_THINKING_BUDGET_TOKENS_LOW=1024
# CLAUDE_THINKING_BUDGET_TOKENS_MEDIUM=2048
# CLAUDE_THINKING_BUDGET_TOKENS_HIGH=4096

# --- Maintenance flags (optional) ---

# Reset all stored user languages on next deploy
# RESET_LANG_ON_DEPLOY=true
